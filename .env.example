# Epic's public R4 sandbox. Replace this for another health system if needed.
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
HEALTH_SYSTEM_NAME=Epic sandbox

# Create/register a patient-facing app in the Epic FHIR developer portal.
# This project's verified sandbox flow uses a public client with PKCE.
# Match this setting to your Epic app registration.
EPIC_OAUTH_CLIENT_MODE=public
# Use your app's non-production Client ID. Public mode does not use a secret.
CLIENT_ID=replace-with-your-non-production-client-id
CLIENT_SECRET=
# For a confidential registration, set EPIC_OAUTH_CLIENT_MODE=confidential
# and CLIENT_SECRET to its matching Sandbox Client Secret.
# Public PKCE fallback (only for an Epic app registered as non-confidential):
# EPIC_OAUTH_CLIENT_MODE=public
# In public mode CLIENT_SECRET is not used, Basic auth is omitted, client_id is
# sent in the token form body, and refresh tokens are never persisted.
# Match Epic's saved Endpoint URI exactly, including the scheme.
# The local server enables HTTPS automatically when this uses https://.
REDIRECT_URI=https://127.0.0.1:3000/callback
# Epic derives resource scopes from the APIs selected in the app registration.
# Empty omits the scope parameter entirely, matching the FHIR_EPIC reference.
# For persistent access with a compatible registration, explicitly configure
# launch/patient offline_access. Without offline_access, refresh is not assured.
FHIR_SCOPES=

# Generate with: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Optional local settings.
DATABASE_PATH=data/hackers-healers.sqlite3
SYNC_HOUR=3

# Server-side only. Never put this key in a VITE_ variable or browser code.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
